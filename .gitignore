# Rust build output
/target/
# wasm app crates build into their own (detached) target dirs
wasm-apps/*/target/
wasm-apps/examples/*/target/
# compiled wasm artifacts (generated by kernel/build.rs into OUT_DIR)
wasm-apps/**/*.wasm
# DOOM (doomgeneric) is GPLv2 upstream — cloned by tools/build-doom.sh, not vendored
wasm-apps/doom/doomgeneric/
# game assets (WADs) are not redistributed in-repo
*.wad
*.WAD

# Generated bootable images
*.img

# Screenshots / captures
*.png
# ...but keep the brand source icon and documentation images
!assets/kitsune-icon.png
!docs/img/*.png

# Editor / OS cruft
*.swp
.DS_Store

# Runtime artifacts
qemu-err.txt
qlog.txt
*.pcap
.shots/

# Claude Code local session state / memory
.claude/

# Performance harness output and the (separate) bench crate build dir
/tools/perf/runs/
/bench/target/

# Runtime artifacts from tools/run.sh
*.pcap
kitsune-ovmf-vars.fd
!wasm-apps/*/icon.png

# user-app build output (detached workspaces)
user-apps/*/target/

# Python bytecode (tools/*.py)
__pycache__/
*.pyc
